{
  "name": "hall-aircon",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial web app for NTU hall Daikin aircons: remote control, schedules and a dashboard, on Cloudflare Workers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhunHao/ntu-hall-aircon.git"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "wrangler deploy",
    "dev": "vite build --watch & wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json"
  },
  "cloudflare": {
    "bindings": {
      "SESSION_SECRET": {
        "description": "Random key that encrypts your stored Daikin login. Generate with `openssl rand -hex 32`."
      },
      "OWNER_EMAIL": {
        "description": "Your NTU email. Only this account can sign in to your copy."
      }
    }
  },
  "dependencies": {
    "@awesome.me/webawesome": "3.14.0",
    "@fontsource/roboto": "5.3.0",
    "@mdi/js": "7.4.47",
    "jose": "6.2.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "5.20261030.1",
    "@msw/cloudflare": "0.2.0",
    "msw": "3.0.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
