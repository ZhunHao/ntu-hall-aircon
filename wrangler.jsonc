{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hall-aircon",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "HOME", "class_name": "Home" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Home"] }],
  // ACCESS_TEAM_DOMAIN and ACCESS_AUD are set in the dashboard (optional, see README). They are not
  // listed under "vars", and keep_vars stops a deploy from deleting them.
  "keep_vars": true,
  "observability": { "enabled": true }
}
